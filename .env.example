# Email (Resend) — get your key at resend.com
RESEND_API_KEY=

# Site URL (used for metadata, OG tags, and sitemap)
NEXT_PUBLIC_SITE_URL=https://thegrowthhub.com.au

# Paid-acquisition pixels (optional). All three render inert when blank,
# so dev / preview environments don't ship telemetry by default.
#
# GA4 measurement ID (G-XXXXXXXX). Get it in GA4 Admin → Data streams.
NEXT_PUBLIC_GA4_ID=
# Meta Pixel ID (15+ digit numeric). Get it in Meta Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=
# LinkedIn Insight Tag Partner ID (6-digit numeric). Get it in LinkedIn
# Campaign Manager → Analytics → Insight Tag.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# Per-conversion LinkedIn IDs — set the ones you've configured as
# LinkedIn conversions in Campaign Manager. Leave blank to skip that
# conversion. (track() will fire when the value is present.)
NEXT_PUBLIC_LINKEDIN_CONV_FREE_JOIN=
NEXT_PUBLIC_LINKEDIN_CONV_NEWSLETTER=
NEXT_PUBLIC_LINKEDIN_CONV_CONTACT=
NEXT_PUBLIC_LINKEDIN_CONV_RSVP=

# HubSpot embedded form (the /expo/apply application page). Both IDs blank →
# the page renders a mailto fallback instead of the form, so dev / preview
# ship nothing. Get them from HubSpot → Marketing → Forms → Share → Embed code.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_EXPO_FORM_ID=
# Portal data-centre region — na1 (default), eu1, etc. Match your embed code.
NEXT_PUBLIC_HUBSPOT_REGION=na1

# HubSpot newsletter submission (server-side, used by /api/newsletter — distinct
# from the NEXT_PUBLIC_* expo-form vars above). Blank → the endpoint returns 503
# and the signup strip shows "temporarily unavailable". Same portal id as above;
# the form GUID comes from HubSpot → Marketing → Forms → ⋮ → Share → Embed code.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
# Region prefix matching the form's data-region: na1 (default), eu1, ap1.
# Production uses ap1 — submitting to the wrong region host silently 404s.
HUBSPOT_REGION=na1

# WorkOS AuthKit — get keys at dashboard.workos.com
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Generate with: openssl rand -base64 32  (must be ≥32 chars)
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Sentry (optional) — leave blank to disable error reporting locally.
# Server DSN and client DSN are the same value; the NEXT_PUBLIC_ copy is what
# the browser bundle reads.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed in CI/Vercel for source map upload. Local builds skip uploads.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Birdeye provisioning ──────────────────────────────────────────────────
# The deployment-wide switch (server-only — do NOT use NEXT_PUBLIC_, it must
# stay flippable at runtime so rollback to `mock` is instant):
#   mock           → nobody hits the real Birdeye API (default / kill switch)
#   live_allowlist → only OPS_EMAILS users go live; everyone else stays mock
#   live           → every active-paid user provisions for real
PROVISION_MODE=mock
# Real reseller credentials — required before flipping PROVISION_MODE off mock.
BIRDEYE_API_KEY=
BIRDEYE_RESELLER_ID=
BIRDEYE_API_HOST=https://api.birdeye.com/resources
# Customer dashboard deep-link. Use a {businessNumber} placeholder once Birdeye
# confirms the canonical path, e.g. https://app.birdeye.com/businesses/{businessNumber}/dashboard
# Defaults to the generic login if unset.
BIRDEYE_DASHBOARD_URL_TEMPLATE=https://app.birdeye.com

# Ops handoff for the post-provision manual steps (module entitlement, Webchat
# config, Apple/FAQs/tags) and partial-run alerts. Email goes via Resend to
# OPS_NOTIFICATION_EMAIL (defaults to hello@himayat.com.au); an optional
# Slack/webhook URL can also receive the JSON summary.
OPS_NOTIFICATION_EMAIL=hello@himayat.com.au
OPS_NOTIFY_WEBHOOK=
# Allowlist for live_allowlist mode (comma-separated). Reuses the ops console
# allowlist; defaults to waheed@himayat.com.au if unset.
OPS_EMAILS=

# Auth for the hourly provisioning retry cron (/api/cron/provision-retry).
# Vercel attaches it as a Bearer token automatically once set; without it the
# cron rejects every invocation.
CRON_SECRET=
# Optional headless access to GET /api/health/provisioning (?secret=...) for
# uptime checkers. Ops users can view it without this.
HEALTH_SECRET=
