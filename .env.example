# ── Required in production (no defaults) ───────────────────────────────────
# The app fails or silently degrades without these. Set them in Vercel →
# Settings → Environment Variables (Production); use test-mode values and a
# Neon *branch* for Preview/Staging (see STAGING.md). Never commit real values.
#
# Neon pooled connection string — used by Drizzle AND Payload. The handoff
# .env.local points this at PRODUCTION; local scripts and the Playwright seed
# refuse to run against it unless ALLOW_PROD=1 (scripts/_guard.mjs).
DATABASE_URL=
# Payload CMS auth secret (openssl rand -base64 32)
PAYLOAD_SECRET=
# Stripe — sk_live_… / whsec_… in Production, test-mode equivalents elsewhere
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs — one per plan × interval plus the two add-ons
# (read in src/lib/plans.ts; all eight must be set for checkout to work)
STRIPE_PRICE_FOUNDATIONS_MONTHLY=
STRIPE_PRICE_FOUNDATIONS_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_ACCELERATE_MONTHLY=
STRIPE_PRICE_ACCELERATE_YEARLY=
STRIPE_PRICE_SEARCH_AI_MONTHLY=
STRIPE_PRICE_REFERRALS_MONTHLY=
# Vercel Blob — Payload media uploads
BLOB_READ_WRITE_TOKEN=
# Shared secret Payload sends to /api/revalidate on publish
REVALIDATION_SECRET=
# PostHog product analytics (browser)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Canonical portal origin, e.g. https://app.thegrowthhub.com.au
NEXT_PUBLIC_APP_URL=
# NON-PRODUCTION ONLY — enables the Playwright auth bypass (/api/test/auth).
# Never set in the Vercel Production environment; see src/lib/auth/with-auth.ts.
PLAYWRIGHT_TEST_TOKEN=
# Optional: Meta Conversions API (server-side events). Blank → disabled.
META_CAPI_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# ── Transactional email (src/lib/email/send.ts, docs/EMAIL.md) ─────────────
# Every app email (welcome, RSVP confirmations + reminders, order emails,
# contact enquiries, ops handoff, payment-failed) goes through sendEmail().
# Provider: hubspot | resend | blank = auto (HubSpot when its two vars below
# are set, else Resend when RESEND_API_KEY is set, else NONE — emails are
# dropped, logged, and config-health FAILS). Production had no provider for
# months; make sure one is set.
EMAIL_PROVIDER=
# HubSpot private-app access token (HubSpot → Settings → Integrations →
# Private Apps). ONE token serves two integrations:
#   • transactional email (below): scope `transactional-email` (needs the
#     Transactional Email add-on on the portal);
#   • CRM sync (src/lib/hubspot/crm.ts, docs/HUBSPOT_CRM.md): scopes
#     `crm.objects.contacts.write`, `crm.objects.contacts.read`,
#     `crm.objects.notes.write`, plus `crm.schemas.contacts.write` ONLY if you
#     want ensureProperties() to create the gh_* contact properties for you.
# Blank → CRM sync is a no-op (one console.warn per process); members, bookings
# and outcomes simply don't reach HubSpot. The gh_* custom contact properties
# must exist on portal 442026767 before contact upserts succeed.
HUBSPOT_PRIVATE_APP_TOKEN=
# Numeric id of the ONE generic transactional email ("Growth Hub — system
# email") whose subject is {{ custom.subject }} and body {{ custom.body_html }}.
# Copy it from the email's URL in Marketing → Email. See docs/EMAIL.md.
HUBSPOT_TRANSACTIONAL_EMAIL_ID=
# Resend — fallback provider (resend.com). Used when HubSpot isn't configured
# or EMAIL_PROVIDER=resend. Only Resend can carry real attachments (.ics).
RESEND_API_KEY=

# Site URL (used for metadata, OG tags, and sitemap)
NEXT_PUBLIC_SITE_URL=https://thegrowthhub.com.au

# Paid-acquisition pixels (optional). All three render inert when blank,
# so dev / preview environments don't ship telemetry by default.
#
# GA4 measurement ID (G-XXXXXXXX). Get it in GA4 Admin → Data streams.
NEXT_PUBLIC_GA4_ID=
# Meta Pixel ID (15+ digit numeric). Get it in Meta Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=
# LinkedIn Insight Tag Partner ID (6-digit numeric). Get it in LinkedIn
# Campaign Manager → Analytics → Insight Tag.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# Per-conversion LinkedIn IDs — set the ones you've configured as
# LinkedIn conversions in Campaign Manager. Leave blank to skip that
# conversion. (track() will fire when the value is present.)
NEXT_PUBLIC_LINKEDIN_CONV_FREE_JOIN=
NEXT_PUBLIC_LINKEDIN_CONV_NEWSLETTER=
NEXT_PUBLIC_LINKEDIN_CONV_CONTACT=
NEXT_PUBLIC_LINKEDIN_CONV_RSVP=
NEXT_PUBLIC_LINKEDIN_CONV_SUMMIT_REGISTER=
NEXT_PUBLIC_LINKEDIN_CONV_SUMMIT_APPLY=

# HubSpot embedded form (the /expo/apply application page). Both IDs blank →
# the page renders a mailto fallback instead of the form, so dev / preview
# ship nothing. Get them from HubSpot → Marketing → Forms → Share → Embed code.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_EXPO_FORM_ID=
# Portal data-centre region — na1 (default), eu1, etc. Match your embed code.
NEXT_PUBLIC_HUBSPOT_REGION=na1

# HubSpot newsletter submission (server-side, used by /api/newsletter — distinct
# from the NEXT_PUBLIC_* expo-form vars above). Blank → the endpoint returns 503
# and the signup strip shows "temporarily unavailable". Same portal id as above;
# the form GUID comes from HubSpot → Marketing → Forms → ⋮ → Share → Embed code.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
# Region prefix matching the form's data-region: na1 (default), eu1, ap1.
# Production uses ap1 — submitting to the wrong region host silently 404s.
HUBSPOT_REGION=na1
# Contact form → HubSpot CRM (F7.11). GUID of a HubSpot form with fields
# firstname, lastname, email, message. Blank → /api/contact only emails ops.
# Uses HUBSPOT_PORTAL_ID / HUBSPOT_REGION above.
HUBSPOT_CONTACT_FORM_ID=
# Set to 1 ONLY after adding a single-line text contact property
# `gh_interests` AND putting it on the form — HubSpot rejects submissions
# that carry a field the form doesn't have. Interest chips are joined with ';'.
HUBSPOT_CONTACT_FORM_HAS_INTERESTS=

# WorkOS AuthKit — get keys at dashboard.workos.com
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Generate with: openssl rand -base64 32  (must be ≥32 chars)
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Sentry (optional) — leave blank to disable error reporting locally.
# Server DSN and client DSN are the same value; the NEXT_PUBLIC_ copy is what
# the browser bundle reads.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed in CI/Vercel for source map upload. Local builds skip uploads.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Birdeye provisioning ──────────────────────────────────────────────────
# The deployment-wide switch (server-only — do NOT use NEXT_PUBLIC_, it must
# stay flippable at runtime so rollback to `mock` is instant):
#   mock           → nobody hits the real Birdeye API (default / kill switch)
#   live_allowlist → only PROVISION_ALLOWLIST users go live; everyone else mock
#   live           → every active-paid user provisions for real
# The legacy NEXT_PUBLIC_PROVISION_MODE is IGNORED by the code and must not be
# set (config-health fails if it is).
PROVISION_MODE=mock
# Who goes live under live_allowlist: comma-separated emails, case-insensitive.
# Keep this SEPARATE from OPS_EMAILS — OPS_EMAILS grants the /ops staff console
# (admin by default). If PROVISION_ALLOWLIST is unset it falls back to
# OPS_EMAILS for back-compat, which would mean pilot customers need ops admin.
PROVISION_ALLOWLIST=
# Real reseller credentials — required before flipping PROVISION_MODE off mock.
BIRDEYE_API_KEY=
BIRDEYE_RESELLER_ID=
BIRDEYE_API_HOST=https://api.birdeye.com/resources
# Customer dashboard deep-link. Use a {businessNumber} placeholder once Birdeye
# confirms the canonical path, e.g. https://app.birdeye.com/businesses/{businessNumber}/dashboard
# Defaults to the generic login if unset.
BIRDEYE_DASHBOARD_URL_TEMPLATE=https://app.birdeye.com

# Ops handoff for the post-provision manual steps (module entitlement, Webchat
# config, Apple/FAQs/tags) and partial-run alerts. Email goes via Resend to
# OPS_NOTIFICATION_EMAIL (defaults to hello@himayat.com.au); an optional
# Slack/webhook URL can also receive the JSON summary.
OPS_NOTIFICATION_EMAIL=hello@himayat.com.au
OPS_NOTIFY_WEBHOOK=
# Staff allowlist for the /ops console (comma-separated "email" or
# "email:role", role = admin | support; bare email = admin). Defaults to
# waheed@himayat.com.au if unset. NOT the Birdeye live allowlist — that is
# PROVISION_ALLOWLIST above (OPS_EMAILS is only its fallback when unset).
OPS_EMAILS=

# Auth for the daily provisioning retry cron (/api/cron/provision-retry;
# schedule in vercel.json — `0 20 * * *`, the Hobby-plan cap).
# Vercel attaches it as a Bearer token automatically once set; without it the
# cron rejects every invocation.
CRON_SECRET=
# Optional headless access to GET /api/health/provisioning (?secret=...) for
# uptime checkers. Ops users can view it without this.
HEALTH_SECRET=

# ── Shop (merch e-commerce, /shop) ─────────────────────────────────────────
# Stripe Shipping Rate IDs (Dashboard → Products → Shipping rates). Create
# them in AUD with tax behaviour "inclusive". Both are required for checkout.
STRIPE_SHIPPING_RATE_STANDARD=
STRIPE_SHIPPING_RATE_EXPRESS=
# Optional: a $0 shipping rate offered INSTEAD of Standard once the cart
# subtotal (after member discount) reaches the threshold. Leave both blank
# to disable free shipping.
STRIPE_SHIPPING_RATE_FREE=
SHOP_FREE_SHIPPING_THRESHOLD_CENTS=
# Stripe Tax Rate (Dashboard → Tax rates): "GST", 10%, Inclusive, AU. Prices
# stay GST-inclusive; attaching the rate lets Stripe receipts itemise GST.
STRIPE_TAX_RATE_GST_INCLUSIVE=
# Printed on order confirmation emails (tax invoice).
SHOP_ABN=
